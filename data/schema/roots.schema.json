{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roots.schema.json",
  "title": "Roots",
  "description": "Shared list of roots, referenced by words in all texts. Stored in data/roots.json, keyed by root (e.g. \"ש-מ-ר\").",
  "type": "object",
  "propertyNames": { "$ref": "text.schema.json#/$defs/root" },
  "additionalProperties": { "$ref": "#/$defs/root" },
  "$defs": {
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meaning"],
      "properties": {
        "meaning": {
          "description": "Core meaning of the root.",
          "type": "string",
          "minLength": 1
        },
        "related": {
          "description": "Common words sharing the root.",
          "type": "array",
          "items": { "$ref": "#/$defs/relatedWord" }
        }
      }
    },
    "relatedWord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hebrew", "meaning"],
      "properties": {
        "hebrew": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 1 }
      }
    }
  }
}
